# Raw bugreports are large and contain personal data (contacts, wifi, logs)
captures/hci/*bugreport*.zip
captures/hci/tmp/
firmware/dumps/*
!firmware/dumps/.gitkeep
*.key
*_ed25519
__pycache__/
# Capturas crudas y derivados: SOLO LOCAL (repo público; contienen tokens, MACs, nombres de rutas)
captures/hci/*
!captures/hci/.gitkeep
captures/ble/*
!captures/ble/.gitkeep
captures/routes/*
!captures/routes/.gitkeep
logs/*
!logs/.gitkeep
*.png
firmware/analysis/apk/
mobile/android/igs-bridge/.gradle/
mobile/android/igs-bridge/app/build/
mobile/android/igs-bridge/build/
mobile/android/igs-bridge/local.properties
!mobile/android/igs-bridge/branding/*.png
!mobile/android/igs-bridge/app/src/main/res/**/*.png
